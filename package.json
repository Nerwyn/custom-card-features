	},
	"homepage": "https://github.com/Nerwyn/custom-card-features#readme",
	"dependencies": {
		"ha-nunjucks": "latest",
		"js-yaml": "^5.2.1",
		"lit": "^3.3.3"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@rspack/cli": "^2.1.2",
		"@rspack/core": "^2.1.2",
		"@typescript-eslint/eslint-plugin": "^8.62.1",
		"@typescript-eslint/parser": "^8.62.1",
		"eslint": "^10.6.0",
		"eslint-config-prettier": "^10.1.8",
