		"lit-css-loader": "^4.0.1",
		"minify-html-literals-loader": "^1.1.1",
		"prettier": "^3.9.4",
		"prettier-plugin-organize-imports": "^4.3.0",
		"ts-loader": "^9.6.2",
		"typescript": "latest",
		"typescript-eslint": "^8.62.1"
	}
